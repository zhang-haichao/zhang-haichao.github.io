---
const dashboardUrl = 'https://zhanghaichao.goatcounter.com/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="description" content="Private visitor analytics dashboard for Haichao Zhang's academic homepage." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Visitor Analytics · Haichao Zhang</title>
    <style>
      :root {
        color: #30343a;
        background: #f5f7fa;
        font-family: "Trebuchet MS", "Noto Sans SC", "Microsoft YaHei", sans-serif;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
      }

      a {
        color: #224b8d;
        text-underline-offset: 0.18em;
      }

      a:focus-visible {
        outline: 2px solid #224b8d;
        outline-offset: 3px;
      }

      .analytics-shell {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        min-height: 100vh;
      }

      .analytics-header {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1.5rem;
        padding: 0.85rem clamp(1rem, 3vw, 2.5rem);
        border-bottom: 1px solid #d9dee4;
        background: rgba(255, 255, 255, 0.97);
      }

      .site-name {
        justify-self: start;
        color: #20252b;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
      }

      .analytics-title {
        text-align: center;
      }

      h1 {
        margin: 0;
        color: #20252b;
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.25;
      }

      .analytics-title p {
        margin: 0.12rem 0 0;
        color: #6b737c;
        font-size: 0.75rem;
      }

      .back-link {
        justify-self: end;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .dashboard-wrap {
        display: grid;
        grid-template-rows: auto minmax(42rem, 1fr);
        gap: 0.75rem;
        min-height: 0;
        padding: 0.8rem clamp(0.6rem, 2vw, 1.5rem) 1.25rem;
      }

      .privacy-note {
        margin: 0;
        color: #626a73;
        font-size: 0.8rem;
        text-align: center;
      }

      .dashboard-frame {
        width: 100%;
        height: 100%;
        min-height: 42rem;
        border: 1px solid #d9dee4;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(31, 44, 59, 0.08);
      }

      .no-script {
        max-width: 40rem;
        margin: 4rem auto;
        padding: 1.25rem;
        border: 1px solid #d9dee4;
        border-radius: 10px;
        background: #fff;
        text-align: center;
      }

      @media (max-width: 640px) {
        .analytics-header {
          grid-template-columns: 1fr auto;
          gap: 0.65rem 1rem;
        }

        .analytics-title {
          grid-column: 1 / -1;
          grid-row: 2;
        }

        .dashboard-wrap {
          grid-template-rows: auto minmax(48rem, 1fr);
        }

        .dashboard-frame {
          min-height: 48rem;
          border-radius: 8px;
        }
      }
    </style>
  </head>
  <body>
    <div class="analytics-shell">
      <header class="analytics-header">
        <a class="site-name" href="/">Haichao Zhang</a>
        <div class="analytics-title">
          <h1>Visitor Analytics · 访客统计</h1>
          <p>Private dashboard · GoatCounter login required</p>
        </div>
        <a class="back-link" href="/">Back to homepage · 返回主页</a>
      </header>

      <main class="dashboard-wrap">
        <p class="privacy-note">Statistics remain private and are visible only after signing in to GoatCounter.</p>
        <iframe
          class="dashboard-frame"
          src={dashboardUrl}
          title="Private GoatCounter visitor analytics dashboard"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <noscript>
          <p class="no-script">
            JavaScript is required for the embedded dashboard. <a href={dashboardUrl}>Open GoatCounter directly</a>.
          </p>
        </noscript>
      </main>
    </div>
  </body>
</html>
